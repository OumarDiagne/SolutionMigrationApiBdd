# Copier ce fichier en .env (ignoré par git) et remplacer les valeurs.
SQL_PASSWORD=<mot de passe SQL Server : 8+ caractères, majuscule, minuscule, chiffre, symbole>
JWT_SIGNING_KEY=<au moins 32 caractères>
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=<mot de passe respectant la politique Identity>
# Port HTTPS côté PC (facultatif, 9443 par défaut ; 8443 est pris par la redirection VirtualBox)
HTTPS_PORT=9443
